# Names only. Copy to .env and fill in; never commit values.

# Storage backend: d1 (default) or local (sqlite file, migrations applied on open)
CBB_STORE=
CBB_LOCAL_DB=

# Cloudflare D1 (REST API)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# CollegeBasketballData API key (ingest, backfill)
CBBD_API_KEY=

# Optional ingest settings (defaults shown)
# CBBD_QUOTA_FLOOR=50       # stop calling the API once X-CallLimit-Remaining is below this
# INGEST_MAX_DROPPED=       # dropped/malformed rows tolerated per run; default max(5, 0.5% of rows)
